# Bu dosyayı .env.local adıyla kopyalayıp değerleri doldurun.

# Google AI Studio > Get API key (ücretsiz katman yeterli)
GEMINI_API_KEY=

# İsteğe bağlı: build.nvidia.com anahtarı. Gemini kotası bitince son yedek olarak kullanılır.
NVIDIA_API_KEY=

# İsteğe bağlı: verilerin tutulacağı klasör (varsayılan: kullanıcı klasöründe .sinav-simulatoru).
# OneDrive gibi senkronize edilen bir klasör SEÇMEYİN; açık veritabanı dosyası bozulabilir.
# DATA_DIR=
