# Bu dosyayı .env.local adıyla kopyalayıp değerleri doldurun.
# Supabase Dashboard > Project Settings > API (veya API Keys)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Yalnızca sunucuda kullanılır, tarayıcıya ASLA gönderilmez.
# Eski "service_role" anahtarı ya da yeni "sb_secret_..." anahtarı olabilir.
SUPABASE_SERVICE_ROLE_KEY=

# Aşama 2'de kullanılacak (Google AI Studio > Get API key)
GEMINI_API_KEY=
